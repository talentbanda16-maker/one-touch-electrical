generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  TECHNICAL_MANAGER
  FOREMAN
  QS
  SHE_OFFICER
  STORESMAN
  FINANCE
  MANAGEMENT
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  DELAYED
  COMPLETED
  CLOSED
}

enum ReportType {
  FOREMAN
  QS
  SHE
  STORES
  FINANCE
}

// DRAFT/RETURNED are for the Step 3 approval workflow; Step 2 reports
// are created straight into SUBMITTED.
enum ReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RETURNED
}

// ---------- Core models (Step 1: Foundation) ----------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignments   ProjectAssignment[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  reports       Report[]
  attachments   Attachment[]

  @@map("users")
}

model Project {
  id                String        @id @default(uuid())
  name              String
  code              String        @unique
  client            String?
  mainContractor    String?
  location          String?
  contractValue     Decimal?      @db.Decimal(14, 2)
  approvedBudget    Decimal?      @db.Decimal(14, 2)
  startDate         DateTime?
  plannedEndDate    DateTime?
  status            ProjectStatus @default(PLANNING)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  assignments ProjectAssignment[]
  reports     Report[]
  attachments Attachment[]

  @@map("projects")
}

// Links a user to a project in a specific role on that project.
// A user's system-wide Role (above) is their job title; this join
// table is what "assigned projects" actually means for RBAC checks.
model ProjectAssignment {
  id        String   @id @default(uuid())
  userId    String
  projectId String
  role      Role
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId, role])
  @@map("project_assignments")
}

// ---------- Auth support ----------

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ---------- Audit trail (append-only, per spec section 1.4/9) ----------

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// ---------- Reports (Step 2: role-specific reporting) ----------

// Shared header for every department report. Department-specific data
// lives in the linked *ReportDetail table (one-to-one). This is what
// lets the Step 5/6 combined-report query pull "everything approved
// for project X between two dates" with one query across all types.
model Report {
  id            String       @id @default(uuid())
  projectId     String
  type          ReportType
  reportDate    DateTime     @db.Date
  status        ReportStatus @default(SUBMITTED)
  submittedById String
  // Client-generated key so a retried offline-sync submission never
  // creates a duplicate report — the API treats a repeat submissionId
  // as "already have this one" instead of inserting again.
  submissionId  String       @unique
  submittedAt   DateTime     @default(now())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  project     Project @relation(fields: [projectId], references: [id])
  submittedBy User    @relation(fields: [submittedById], references: [id])

  foremanDetail ForemanReportDetail?
  qsDetail      QsReportDetail?
  attachments   Attachment[]

  @@map("reports")
}

// Photos/documents. reportId is required for now since Report is the
// only parent type that exists yet — spec Section 19 also allows
// instruction/action/finance-line parents, added when those tables exist.
// storageKey is a relative path today (local disk); swapping to S3
// later only changes how storageKey is resolved to bytes, not this table.
model Attachment {
  id           String   @id @default(uuid())
  reportId     String
  projectId    String
  fileName     String
  storageKey   String
  mimeType     String
  fileSize     Int
  uploadedById String
  createdAt    DateTime @default(now())

  report     Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  project    Project @relation(fields: [projectId], references: [id])
  uploadedBy User    @relation(fields: [uploadedById], references: [id])

  @@map("attachments")
}

model ForemanReportDetail {
  id                  String  @id @default(uuid())
  reportId            String  @unique
  siteLocation        String?
  workersOnSite        Int     @default(0)
  labourSkilled        Int     @default(0)
  labourUnskilled      Int     @default(0)
  labourSubcontractor  Int     @default(0)
  workCompleted        String?
  workInProgress       String?
  percentProgress      Int     @default(0)
  equipmentUsed        String?
  materialsUsed        String?
  materialsRequired    String?
  constraints          String?
  instructionsReceived String?
  nextDayPlan          String?

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("foreman_report_details")
}

// ---------- QS (header + line items, per spec Section 6/7) ----------

model QsReportDetail {
  id       String  @id @default(uuid())
  reportId String  @unique
  comments String?

  report Report        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  lines  QsReportLine[]

  @@map("qs_report_details")
}

model QsReportLine {
  id                String   @id @default(uuid())
  qsReportDetailId  String
  boqItemNumber     String
  description       String
  contractQuantity  Decimal  @db.Decimal(14, 2)
  // cumulativeQuantity and contractQuantity are the source numbers;
  // balanceQuantity and percentCompletion are derived server-side
  // (never trust client math for progress/financial figures — spec 9.3).
  quantityToday       Decimal @db.Decimal(14, 2)
  cumulativeQuantity  Decimal @db.Decimal(14, 2)
  balanceQuantity     Decimal @db.Decimal(14, 2)
  percentCompletion   Int
  measurements        String?
  valuationAmount     Decimal? @db.Decimal(14, 2)
  variationReference  String?
  comments            String?

  qsReportDetail QsReportDetail @relation(fields: [qsReportDetailId], references: [id], onDelete: Cascade)

  @@map("qs_report_lines")
}
