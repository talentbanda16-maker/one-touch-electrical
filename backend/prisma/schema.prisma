generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  TECHNICAL_MANAGER
  FOREMAN
  QS
  SHE_OFFICER
  STORESMAN
  FINANCE
  MANAGEMENT
  GENERAL_WORKER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  DELAYED
  COMPLETED
  CLOSED
}

enum ReportType {
  FOREMAN
  QS
  SHE
  STORES
  FINANCE
}

// DRAFT/RETURNED are for the Step 3 approval workflow; Step 2 reports
// are created straight into SUBMITTED.
enum ReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RETURNED
}

// ---------- Core models (Step 1: Foundation) ----------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignments   ProjectAssignment[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  reports       Report[]
  reviewedReports Report[] @relation("ReportReviewer")
  reportRevisionsReturned ReportRevision[] @relation("ReportRevisionReturnedBy")
  attachments   Attachment[]
  instructionsResponsibleFor Instruction[] @relation("InstructionResponsible")
  instructionsIssued         Instruction[] @relation("InstructionIssuedBy")
  instructionsVerified       Instruction[] @relation("InstructionVerifiedBy")
  actionsAssigned Action[] @relation("ActionAssignedTo")
  actionsCreated  Action[] @relation("ActionCreatedBy")
  actionsVerified Action[] @relation("ActionVerifiedBy")
  projectsManaged Project[] @relation("ProjectManager")
  requisitionsRequested MaterialRequisition[] @relation("RequisitionRequestedBy")
  requisitionsFulfilled MaterialRequisition[] @relation("RequisitionFulfilledBy")
  programmeEntries      ProgrammeEntry[]
  notifications         Notification[]
  reportDrafts          ReportDraft[]
  productivityReportsSubmitted ProductivityReport[] @relation("ProductivityReportSubmitter")
  productivityReportsReviewed  ProductivityReport[] @relation("ProductivityReportReviewer")
  productivityReportsFinalized ProductivityReport[] @relation("ProductivityReportFinalizer")

  @@map("users")
}

model Project {
  id                String        @id @default(uuid())
  name              String
  code              String        @unique
  client            String?
  mainContractor    String?
  location          String?
  contractValue     Decimal?      @db.Decimal(14, 2)
  approvedBudget    Decimal?      @db.Decimal(14, 2)
  startDate         DateTime?
  plannedEndDate    DateTime?
  status            ProjectStatus @default(PLANNING)
  // Attribution/accountability only — every Technical Manager already has
  // full access to every project via the role bypass, so this doesn't
  // gate anything, it just records who's actually responsible for it.
  projectManagerId  String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  projectManager User? @relation("ProjectManager", fields: [projectManagerId], references: [id])
  assignments ProjectAssignment[]
  reports     Report[]
  attachments Attachment[]
  instructions Instruction[]
  actions      Action[]
  snapshots    ProjectSnapshot[]
  requisitions MaterialRequisition[]
  programmeEntries ProgrammeEntry[]
  notifications Notification[]
  reportDrafts  ReportDraft[]
  productivityReports ProductivityReport[]

  @@map("projects")
}

// A saved-in-progress report — spec Section 20's "employee creates
// report" as a step distinct from "submits report". Deliberately NOT
// stored in the Report table: it holds raw, unvalidated form state as
// JSON (whatever shape the form happens to be in, including empty
// required fields), so it never needs the strict per-type validation
// real submission uses, and can never leak into report counts, the
// approval queue, or analytics — those all query Report, not this.
model ReportDraft {
  id         String     @id @default(uuid())
  userId     String
  projectId  String
  type       ReportType
  reportDate DateTime   @db.Date
  data       Json
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId, type])
  @@map("report_drafts")
}

// One row per project per day — built up over time by a snapshot job
// so "trend" charts (fund utilisation, progress) have real history to
// plot instead of a single live-computed point. See routes/projects.js
// for the shared calculation this is derived from.
model ProjectSnapshot {
  id                     String   @id @default(uuid())
  projectId              String
  snapshotDate           DateTime @db.Date
  actualProgress         Int
  plannedProgress        Int?
  fundUtilisationPercent Int?
  totalFundsReceived     Decimal  @db.Decimal(14, 2)
  totalExpenditure       Decimal  @db.Decimal(14, 2)
  createdAt              DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, snapshotDate])
  @@map("project_snapshots")
}

// The actual approved programme, maintained by the Technical Manager —
// one row per reporting period with its planned progress. When a project
// has entries, planned progress is interpolated between the two
// surrounding periods instead of the linear start/end-date estimate
// analytics.js falls back to when a project has none yet.
model ProgrammeEntry {
  id              String   @id @default(uuid())
  projectId       String
  periodDate      DateTime @db.Date
  plannedProgress Int
  createdById     String
  createdAt       DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id])

  @@unique([projectId, periodDate])
  @@map("programme_entries")
}

// Links a user to a project in a specific role on that project.
// A user's system-wide Role (above) is their job title; this join
// table is what "assigned projects" actually means for RBAC checks.
model ProjectAssignment {
  id        String   @id @default(uuid())
  userId    String
  projectId String
  role      Role
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId, role])
  @@map("project_assignments")
}

// ---------- Auth support ----------

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ---------- Audit trail (append-only, per spec section 1.4/9) ----------

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// ---------- Reports (Step 2: role-specific reporting) ----------

// Shared header for every department report. Department-specific data
// lives in the linked *ReportDetail table (one-to-one). This is what
// lets the Step 5/6 combined-report query pull "everything approved
// for project X between two dates" with one query across all types.
model Report {
  id            String       @id @default(uuid())
  projectId     String
  type          ReportType
  reportDate    DateTime     @db.Date
  status        ReportStatus @default(SUBMITTED)
  submittedById String
  // Client-generated key so a retried offline-sync submission never
  // creates a duplicate report — the API treats a repeat submissionId
  // as "already have this one" instead of inserting again.
  submissionId  String       @unique
  submittedAt   DateTime     @default(now())
  // Set on approve/return; null while still SUBMITTED.
  reviewedById  String?
  reviewedAt    DateTime?
  returnReason  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  project     Project @relation(fields: [projectId], references: [id])
  submittedBy User    @relation(fields: [submittedById], references: [id])
  reviewedBy  User?   @relation("ReportReviewer", fields: [reviewedById], references: [id])

  foremanDetail ForemanReportDetail?
  qsDetail      QsReportDetail?
  sheDetail     SheReportDetail?
  storesDetail  StoresReportDetail?
  financeDetail FinanceReportDetail?
  attachments   Attachment[]
  revisions     ReportRevision[]
  actionsRaised Action[]

  @@map("reports")
}

// One row per return: a full snapshot of the report + its detail data
// as it stood at that moment, so a correction never silently erases
// what was originally submitted (spec Section 2.4/9 — "not silently
// altered; corrections recorded as revisions").
model ReportRevision {
  id           String   @id @default(uuid())
  reportId     String
  snapshot     Json
  reason       String
  returnedById String
  returnedAt   DateTime @default(now())

  report     Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  returnedBy User   @relation("ReportRevisionReturnedBy", fields: [returnedById], references: [id])

  @@map("report_revisions")
}

// Photos/documents. reportId is required for now since Report is the
// only parent type that exists yet — spec Section 19 also allows
// instruction/action/finance-line parents, added when those tables exist.
// storageKey is a relative path today (local disk); swapping to S3
// later only changes how storageKey is resolved to bytes, not this table.
// Exactly one of reportId/instructionId/actionId must be set — enforced
// in the upload route, not the DB (Prisma has no declarative XOR
// constraint), matching spec Section 19's "exactly one valid parent."
model Attachment {
  id            String   @id @default(uuid())
  reportId      String?
  instructionId String?
  actionId      String?
  projectId     String
  fileName      String
  storageKey    String
  mimeType      String
  fileSize      Int
  uploadedById  String
  createdAt     DateTime @default(now())

  report      Report?      @relation(fields: [reportId], references: [id], onDelete: Cascade)
  instruction Instruction? @relation(fields: [instructionId], references: [id], onDelete: Cascade)
  action      Action?      @relation(fields: [actionId], references: [id], onDelete: Cascade)
  project     Project      @relation(fields: [projectId], references: [id])
  uploadedBy  User         @relation(fields: [uploadedById], references: [id])

  @@map("attachments")
}

model ForemanReportDetail {
  id                   String  @id @default(uuid())
  reportId             String  @unique
  siteLocation         String?
  // Manpower on site — fixed categories matching the paper form's
  // section 4 table; workersOnSite is the Total Workforce row, computed
  // server-side as the sum of the categories below rather than trusted
  // from the client.
  electricalSupervisors Int    @default(0)
  electricians          Int    @default(0)
  electricalAssistants  Int    @default(0)
  generalHands          Int    @default(0)
  sheOfficersOnSite     Int    @default(0)
  workersOnSite        Int     @default(0)
  workCompleted        String?
  workInProgress       String?
  percentProgress      Int     @default(0)
  equipmentUsed        String?
  materialsUsed        String?
  materialsRequired    String?
  constraints          String?
  instructionsReceived String?
  nextDayPlan          String?

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("foreman_report_details")
}

// ---------- QS (header + line items, per spec Section 6/7) ----------

model QsReportDetail {
  id                String  @id @default(uuid())
  reportId          String  @unique
  comments          String?
  // Non-quantity commercial matters (disputes, pricing queries, pending
  // instructions with cost impact) — distinct from the line-level
  // variationReference, which is specific to one BOQ item's variation.
  commercialIssues  String?

  report Report        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  lines  QsReportLine[]

  @@map("qs_report_details")
}

enum VariationStatus {
  PENDING
  APPROVED
  REJECTED
}

model QsReportLine {
  id                String   @id @default(uuid())
  qsReportDetailId  String
  boqItemNumber     String
  description       String
  contractQuantity  Decimal  @db.Decimal(14, 2)
  // cumulativeQuantity and contractQuantity are the source numbers;
  // balanceQuantity and percentCompletion are derived server-side
  // (never trust client math for progress/financial figures — spec 9.3).
  quantityToday       Decimal @db.Decimal(14, 2)
  cumulativeQuantity  Decimal @db.Decimal(14, 2)
  balanceQuantity     Decimal @db.Decimal(14, 2)
  percentCompletion   Int
  measurements        String?
  valuationAmount     Decimal? @db.Decimal(14, 2)
  variationReference  String?
  variationStatus     VariationStatus?
  comments            String?

  qsReportDetail QsReportDetail @relation(fields: [qsReportDetailId], references: [id], onDelete: Cascade)

  @@map("qs_report_lines")
}

// ---------- SHE (per spec Section 8) ----------

// Scoped to exactly the SHE Officer's main functions per spec Section 3's
// role table (Toolbox talks, inspections, PPE, incidents, near misses,
// corrective actions) — narrower than the full Section 8 field list.
model SheReportDetail {
  id                    String  @id @default(uuid())
  reportId              String  @unique
  workersOnSite         Int     @default(0)
  toolboxTalksConducted String?
  safetyInspections     String?
  ppeCompliance         String?
  hazardsIdentified     String?
  correctiveActions     String?
  environmentalIssues   String?
  safetyObservations    String?
  incidentCount         Int     @default(0)
  nearMissCount         Int     @default(0)
  incidentsDescription  String?

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("she_report_details")
}

// ---------- Stores (per spec Section 9) ----------

enum StockDirection {
  RECEIVED
  ISSUED
  RETURNED
  DAMAGED_LOST
}

model StoresReportDetail {
  id                       String  @id @default(uuid())
  reportId                 String  @unique
  shortagesAndRequirements String?
  comments                 String?

  report Report                 @relation(fields: [reportId], references: [id], onDelete: Cascade)
  lines  StockTransactionLine[]

  @@map("stores_report_details")
}

// Opening/closing stock balances are a running total across many of
// these lines over time (spec 9.3: calculated from source records,
// not stored here) — Step 2 only captures each day's movements.
model StockTransactionLine {
  id                    String         @id @default(uuid())
  storesReportDetailId  String
  itemName              String
  direction             StockDirection
  quantity              Decimal        @db.Decimal(14, 2)
  unit                  String?
  unitCost              Decimal?       @db.Decimal(14, 2)
  supplier              String?
  deliveryReference     String?
  notes                 String?
  // Server-derived, never trusted from the client (same rule as QS's
  // balanceQuantity) — the running balance for this item immediately
  // before and after this one movement, computed from every prior
  // APPROVED line for the same item on the same project.
  openingBalance        Decimal        @default(0) @db.Decimal(14, 2)
  closingBalance        Decimal        @default(0) @db.Decimal(14, 2)

  storesReportDetail StoresReportDetail @relation(fields: [storesReportDetailId], references: [id], onDelete: Cascade)

  @@map("stock_transaction_lines")
}

// ---------- Material requisitions (per spec Section 9) ----------

enum RequisitionStatus {
  PENDING
  FULFILLED
  CANCELLED
}

// A real request/fulfil workflow — distinct from the free-text
// "shortagesAndRequirements" note on a Stores report, which is just a
// comment, not a tracked item with a status.
model MaterialRequisition {
  id                String            @id @default(uuid())
  projectId         String
  itemName          String
  quantityRequested Decimal           @db.Decimal(14, 2)
  unit              String?
  urgency           Priority          @default(MEDIUM)
  status            RequisitionStatus @default(PENDING)
  notes             String?
  requestedById     String
  requestedAt       DateTime          @default(now())
  fulfilledById     String?
  fulfilledAt       DateTime?
  fulfillmentNotes  String?

  project     Project @relation(fields: [projectId], references: [id])
  requestedBy User    @relation("RequisitionRequestedBy", fields: [requestedById], references: [id])
  fulfilledBy User?   @relation("RequisitionFulfilledBy", fields: [fulfilledById], references: [id])

  @@map("material_requisitions")
}

// ---------- Finance (per spec Section 10) ----------

enum FinanceLineType {
  FUNDS_RECEIVED
  EXPENDITURE
  COMMITMENT
}

enum FinanceCategory {
  ADVANCE_PAYMENT
  OTHER_FUNDS
  MATERIALS
  LABOUR
  PLANT_EQUIPMENT
  TRANSPORT_LOGISTICS
  SUBCONTRACTOR
  SUPPLIER
  PETTY_CASH
  OTHER
}

model FinanceReportDetail {
  id       String  @id @default(uuid())
  reportId String  @unique
  comments String?

  report Report                  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  lines  FinanceTransactionLine[]

  @@map("finance_report_details")
}

// Project-wide totals (total funds received, actual expenditure to
// date, balance available, fund utilisation %) are rollups across every
// approved Finance report over the project's life — spec 9.3 dashboard/
// analytics work for a later step, not computed from one submission.
model FinanceTransactionLine {
  id                    String           @id @default(uuid())
  financeReportDetailId String
  type                  FinanceLineType
  category              FinanceCategory
  amount                Decimal          @db.Decimal(14, 2)
  description           String?
  paymentReference      String?

  financeReportDetail FinanceReportDetail @relation(fields: [financeReportDetailId], references: [id], onDelete: Cascade)

  @@map("finance_transaction_lines")
}

// ---------- General Worker daily productivity report ----------
// A three-stage sequential form, not the single submit->approve/return
// cycle every other report type uses: the General Worker fills sections
// A-I and submits (SUBMITTED); the Foreman then adds section J, the
// supervisor review (SUPERVISOR_REVIEWED); the Technical Manager then
// adds sections K/L, the management control and follow-up sections, and
// that's final (COMPLETED). Each stage adds its own fields to the same
// record rather than replacing what came before, so there's no
// approve/return branch here — once a stage is done it's done.
//
// The line-item tables on the paper form (work targets, work not
// completed, delays, materials required, tomorrow's plan) are stored as
// Json rather than five more child tables — none of them feed cross-
// report analytics the way QS/Stores lines do, they're just structured
// content for this one report.
enum ProductivityReportStatus {
  SUBMITTED
  SUPERVISOR_REVIEWED
  COMPLETED
}

model ProductivityReport {
  id            String                   @id @default(uuid())
  projectId     String
  submittedById String
  reportDate    DateTime
  status        ProductivityReportStatus @default(SUBMITTED)
  submittedAt   DateTime                 @default(now())
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  // Header (worker-filled)
  employeeIdNumber String?
  department       String?
  position         String?
  siteLocation     String?
  supervisorName   String?
  shift            String?

  // A. Daily work targets — [{ task, unit, target, actual, startTime, endTime }]
  workTargets               Json
  totalTarget                Decimal? @db.Decimal(10, 2)
  totalCompleted              Decimal? @db.Decimal(10, 2)
  overallAchievementPercent  Int?

  // B. Work completed today (free text)
  workCompletedToday String?

  // C. Work not completed — [{ task, remainingWork, reason }]
  workNotCompleted Json?

  // D. Delays / time lost
  delayExperienced Boolean  @default(false)
  totalDelayHours  Decimal? @db.Decimal(6, 2)
  delays           Json? // [{ time, duration, reason, cause, verified }]
  delayCategories  String[]

  // E. Materials / tools required — [{ item, qtyRequired, available, shortage }]
  materialsRequired Json?

  // F. Quality check
  qualityStandardMet String? // YES | NO | REQUIRES_CORRECTION
  reworkDetails       String?

  // G. End-of-day summary
  normalHours            Decimal? @db.Decimal(5, 2)
  actualHoursWorked      Decimal? @db.Decimal(5, 2)
  productiveHours        Decimal? @db.Decimal(5, 2)
  delayHours             Decimal? @db.Decimal(5, 2)
  overtimeRequested      Boolean  @default(false)
  overtimeHoursRequested Decimal? @db.Decimal(5, 2)
  overtimeReason         String?
  expectedOvertimeOutput String?

  // H. Tomorrow's plan — [{ task, targetQuantity, materialsRequired }]
  tomorrowPlan Json?

  // I. Employee declaration
  employeeSignatureName String?

  // J. Supervisor (Foreman) review
  reviewedById             String?
  reviewedAt               DateTime?
  targetAchievementPercent Int?
  productivityRating       String? // EXCELLENT | GOOD | ATTENTION | CRITICAL
  delayJustified           String? // YES | NO | PARTIAL
  overtimeRecommendation   String? // APPROVED | NOT_APPROVED | NA
  supervisorComments       String?
  supervisorSignatureName  String?

  // K. Daily productivity control — Management use (TM fills; TM/Management-only to view)
  finalizedById         String?
  finalizedAt           DateTime?
  productivityScore     Int?
  overtimeHoursApproved Decimal? @db.Decimal(5, 2)
  overtimeCost          Decimal? @db.Decimal(10, 2)

  // L. Management action / follow-up (TM fills; TM/Management-only to view)
  managementActions String[]

  project     Project @relation(fields: [projectId], references: [id])
  submittedBy User    @relation("ProductivityReportSubmitter", fields: [submittedById], references: [id])
  reviewedBy  User?   @relation("ProductivityReportReviewer", fields: [reviewedById], references: [id])
  finalizedBy User?   @relation("ProductivityReportFinalizer", fields: [finalizedById], references: [id])

  @@map("productivity_reports")
}

// ---------- Instructions & Actions (Step 4, per spec Section 13/14) ----------

enum Priority {
  LOW
  MEDIUM
  HIGH
}

// "Overdue" (spec Section 13) is deliberately not a stored value here —
// it's derived from dueDate < now() while status is OPEN/IN_PROGRESS,
// computed at query time so it's never stale waiting on a cron job.
enum WorkItemStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CLOSED
}

model Instruction {
  id                 String         @id @default(uuid())
  projectId          String
  instructionNumber  String
  description        String
  priority           Priority       @default(MEDIUM)
  status             WorkItemStatus @default(OPEN)
  personResponsibleId String
  issuedById         String
  dateIssued         DateTime       @default(now())
  dueDate            DateTime       @db.Date
  verifiedById       String?
  verifiedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  project           Project @relation(fields: [projectId], references: [id])
  personResponsible User    @relation("InstructionResponsible", fields: [personResponsibleId], references: [id])
  issuedBy          User    @relation("InstructionIssuedBy", fields: [issuedById], references: [id])
  verifiedBy        User?   @relation("InstructionVerifiedBy", fields: [verifiedById], references: [id])
  attachments        Attachment[]

  @@unique([projectId, instructionNumber])
  @@map("instructions")
}

// Can originate from a report review (sourceReportId set) or be raised
// standalone — spec Section 14: "Create an action from any department report."
model Action {
  id             String         @id @default(uuid())
  projectId      String
  sourceReportId String?
  description    String
  priority       Priority       @default(MEDIUM)
  status         WorkItemStatus @default(OPEN)
  assignedToId   String
  createdById    String
  dueDate        DateTime       @db.Date
  comments       String?
  verifiedById   String?
  verifiedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  project      Project @relation(fields: [projectId], references: [id])
  sourceReport Report? @relation(fields: [sourceReportId], references: [id])
  assignedTo   User    @relation("ActionAssignedTo", fields: [assignedToId], references: [id])
  createdBy    User    @relation("ActionCreatedBy", fields: [createdById], references: [id])
  verifiedBy   User?   @relation("ActionVerifiedBy", fields: [verifiedById], references: [id])
  attachments  Attachment[]

  @@map("actions")
}

// ---------- Notifications (spec Section 18) ----------

enum NotificationType {
  REPORT_NOT_SUBMITTED
  REPORT_RETURNED
  REPORT_AWAITING_APPROVAL
  ACTION_DUE_SOON
  ACTION_OVERDUE
  MATERIAL_SHORTAGE
  REQUISITION_SUBMITTED
  SAFETY_INCIDENT
  PROGRESS_BEHIND_PLAN
  FUND_UTILISATION_THRESHOLD
  // Generic — one per entry in computeProjectAnalytics().exceptions, so
  // any cross-domain alert added there (spec Section 21) automatically
  // becomes a proactive notification too, not just page data.
  PROJECT_EXCEPTION
}

// Some types are created inline at the moment the triggering event
// happens (a report gets returned, a requisition is raised) — real-time,
// no polling needed. The rest (not-submitted-today, due-soon, overdue,
// behind-plan, fund-threshold) are time-based conditions with no single
// triggering request, so they're generated by an opportunistic scan
// (lib/notifications.js), same "no real cron yet" pattern as
// ensureTodaySnapshots. dedupeKey makes re-running that scan safe —
// upserting on it means the same condition never creates a second
// notification, and doesn't reset one already marked read.
model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  projectId String?
  link      String?
  dedupeKey String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@map("notifications")
}
